          ],
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Revenue is distributed across three regions. AMERICAS leads with approximately 40% of total revenue, followed by EMEA at around 36%, and APAC at approximately 24%. Total revenue across all regions is approximately $214 million."
              }
            ]
          }
        }
      ]
    },
    {
      "eval_id": "sales_monthly_trends",
      "session_input": {
        "app_name": "retail_analytics_agents",
