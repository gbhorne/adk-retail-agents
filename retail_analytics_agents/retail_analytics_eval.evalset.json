{
  "eval_set_id": "retail_analytics_eval",
  "name": "Retail Analytics Multi-Agent Evaluation",
  "description": "Tests routing, tool selection, and response quality for the retail analytics multi-agent system across inventory, sales, and customer domains.",
  "eval_cases": [
    {
      "eval_id": "inventory_stockout_check",
      "session_input": {
        "app_name": "retail_analytics_agents",
        "user_id": "eval_user_01",
        "state": {}
      },
      "conversation": [
        {
          "invocation_id": "turn_1_stockout",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Which products are at risk of stockout?"
              }
            ]
          },
          "expected_tool_use": [
            {
              "tool_name": "transfer_to_agent",
              "tool_input": {
                "agent_name": "inventory_analyst"
              }
            },
            {
              "tool_name": "get_inventory_stockout_risk"
            }
          ],
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Several products are currently at risk of stockout with 0 units in stock. These products have stock levels below their reorder points and require immediate replenishment to prevent lost sales."
              }
            ]
          }
        }
      ]
    },
    {
      "eval_id": "inventory_overstock_check",
      "session_input": {
        "app_name": "retail_analytics_agents",
        "user_id": "eval_user_02",
        "state": {}
      },
      "conversation": [
        {
          "invocation_id": "turn_1_overstock",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "Are any products overstocked right now?"
              }
            ]
          },
          "expected_tool_use": [
            {
              "tool_name": "transfer_to_agent",
              "tool_input": {
                "agent_name": "inventory_analyst"
              }
            },
            {
              "tool_name": "get_overstock_products"
            }
          ],
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Yes, there are products with stock levels significantly above their reorder points. These overstocked items are tying up capital and may need inventory reduction strategies such as promotions or redistribution to other stores."
              }
            ]
          }
        }
      ]
    },
    {
      "eval_id": "inventory_regional_summary",
      "session_input": {
        "app_name": "retail_analytics_agents",
        "user_id": "eval_user_03",
        "state": {}
      },
      "conversation": [
        {
          "invocation_id": "turn_1_inv_region",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "How is our inventory distributed across regions?"
              }
            ]
          },
          "expected_tool_use": [
            {
              "tool_name": "transfer_to_agent",
              "tool_input": {
                "agent_name": "inventory_analyst"
              }
            },
            {
              "tool_name": "get_inventory_summary_by_region"
            }
          ],
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Inventory is distributed across AMERICAS, EMEA, and APAC regions. The summary shows total stock levels, average quantities, and the number of items below reorder point or in stockout status for each region."
              }
            ]
          }
        }
      ]
    },
    {
      "eval_id": "sales_top_products",
      "session_input": {
        "app_name": "retail_analytics_agents",
        "user_id": "eval_user_04",
        "state": {}
      },
      "conversation": [
        {
          "invocation_id": "turn_1_top_products",
          "user_content": {
            "role": "user",
            "parts": [
