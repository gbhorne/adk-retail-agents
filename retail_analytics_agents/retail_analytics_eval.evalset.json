          "expected_tool_use": [
            {
              "tool_name": "transfer_to_agent",
              "tool_input": {
                "agent_name": "sales_analyst"
              }
            },
            {
              "tool_name": "get_top_products_by_revenue"
            }
          ],
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "The top 5 products by revenue are all in the Electronics category, with total revenues ranging from approximately $1.8 million to $2.2 million each. TechPro and DigitalEdge are the leading brands."
              }
            ]
          }
        }
      ]
    },
    {
      "eval_id": "sales_regional_revenue",
      "session_input": {
        "app_name": "retail_analytics_agents",
        "user_id": "eval_user_05",
        "state": {}
      },
      "conversation": [
        {
          "invocation_id": "turn_1_region_revenue",
          "user_content": {
