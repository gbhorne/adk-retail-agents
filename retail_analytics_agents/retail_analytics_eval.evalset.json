              "tool_name": "transfer_to_agent",
              "tool_input": {
                "agent_name": "sales_analyst"
              }
            },
            {
              "tool_name": "get_revenue_by_category"
            }
          ],
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Electronics is the top revenue category, accounting for approximately 46% of total revenue, followed by Home products. Clothing, Beauty, and Grocery contribute smaller shares. Margins vary by category, with Beauty and Clothing showing higher average margins."
              }
            ]
          }
        }
      ]
    },
    {
