          },
          "expected_tool_use": [
            {
              "tool_name": "transfer_to_agent",
              "tool_input": {
                "agent_name": "sales_analyst"
              }
            },
            {
              "tool_name": "get_sales_trends_by_month"
            }
          ],
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Monthly sales data shows revenue trends over the past year. Sales showed a consistent growth trajectory with peak monthly revenue in December. The data includes transaction counts, monthly revenue totals, and average transaction values."
              }
            ]
          }
        }
      ]
    },
    {
      "eval_id": "sales_category_breakdown",
      "session_input": {
        "app_name": "retail_analytics_agents",
        "user_id": "eval_user_07",
        "state": {}
